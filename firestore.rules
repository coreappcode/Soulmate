rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationParticipant(conversationId) {
      return signedIn()
        && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.userIds;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /settings/{settingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /blocks/{blockedUserId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn()
          && request.auth.uid == userId
          && blockedUserId != userId
          && request.resource.data.keys().hasOnly(['createdAt']);
      }
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.verified == false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.verified == resource.data.verified;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /swipes/{swipeId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.liked is bool;
      allow update: if signedIn()
        && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.liked is bool;
      allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds[0] < request.resource.data.userIds[1]
        && matchId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]
        && getAfter(/databases/$(database)/documents/swipes/$(request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1])).data.liked == true
        && getAfter(/databases/$(database)/documents/swipes/$(request.resource.data.userIds[1] + '_' + request.resource.data.userIds[0])).data.liked == true;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds[0] < request.resource.data.userIds[1]
        && conversationId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]
        && (existsAfter(/databases/$(database)/documents/matches/$(conversationId))
          || existsAfter(/databases/$(database)/documents/friendships/$(conversationId)));
      allow update: if signedIn()
        && request.auth.uid in resource.data.userIds
        && request.resource.data.userIds == resource.data.userIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'updatedAt', 'archivedBy']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && request.resource.data.attachmentType in [null, 'image', 'audio', 'document'];
        allow update: if false;
        allow delete: if isConversationParticipant(conversationId);
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && (
          (resource.data.recipientId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.senderId == request.auth.uid
            && resource.data.status == 'declined'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'createdAt'])
            && request.resource.data.status == 'pending')
        );
      allow delete: if signedIn()
        && (resource.data.senderId == request.auth.uid
          || resource.data.recipientId == request.auth.uid);
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.userIds;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds[0] < request.resource.data.userIds[1]
        && friendshipId == request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]
        && (
          (existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1]))
            && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.userIds[0] + '_' + request.resource.data.userIds[1])).data.status == 'accepted')
          || (existsAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.userIds[1] + '_' + request.resource.data.userIds[0]))
            && getAfter(/databases/$(database)/documents/friendRequests/$(request.resource.data.userIds[1] + '_' + request.resource.data.userIds[0])).data.status == 'accepted')
        );
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.userIds;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'reporterId', 'targetId', 'reason', 'details', 'status', 'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId != request.auth.uid
        && request.resource.data.reason in [
          'Inappropriate content',
          'Harassment or bullying',
          'Scam or fraud',
          'Fake profile',
          'Spam',
          'Other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }
  }
}
