{
  "rules": {
    ".read": "auth != null",
    ".write": false,
    "presence": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.hasChildren(['connections'])",
        "connections": {
          "$connectionId": {
            ".validate": "newData.isNumber()"
          }
        },
        "$other": {
          ".validate": "$other == 'connections'"
        }
      }
    }
  }
}
